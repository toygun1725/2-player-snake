# 2 Player Snake - iOS Fastlane Fastfile
# macOS gerektirmeden GitHub Actions üzerinde iOS derleme ve TestFlight yükleme hattı

require "open3"

default_platform(:ios)

platform :ios do
  desc "TestFlight'a yeni bir iOS sürümü derler ve otomatik yükler"
  lane :beta do |options|
    cloudkit_testflight = ENV["SNAKE_ENABLE_TESTFLIGHT_CLOUDKIT"] == "true"
    cloudkit_release = ENV["SNAKE_ENABLE_RELEASE_CLOUDKIT"] == "true"
    if cloudkit_testflight == cloudkit_release
      UI.user_error!("iCloud açık iç test veya yayın adayı seçeneklerinden tam biri seçilmelidir.")
    end
    if cloudkit_release
      # Also enforce the live-web check when the lane is invoked outside CI.
      sh("node", File.expand_path("../../../tools/check-ios-live-release.cjs", __dir__))
    end
    # 1. Gerekli Ortam Değişkenlerini Doğrula
    UI.user_error!("APP_STORE_CONNECT_KEY_ID eksik!") unless ENV["APP_STORE_CONNECT_KEY_ID"]
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID eksik!") unless ENV["APP_STORE_CONNECT_ISSUER_ID"]
    UI.user_error!("APP_STORE_CONNECT_PRIVATE_KEY eksik!") unless ENV["APP_STORE_CONNECT_PRIVATE_KEY"]

    # 2. App Store Connect API Anahtarı Tanımla
    # Private Key metin formatında ya da base64 olarak secret'tan okunur
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 3. CI Ortamı için Geçici Anahtarlık (Keychain) Hazırla
    keychain_name = "github_actions_keychain"
    keychain_password = ENV["CI_KEYCHAIN_PASSWORD"] || "SnakeCI_Temporary_Pass_2026!"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # macOS Sierra'dan beri anahtarlık dosyaları '-db' uzantısıyla kaydedilir.
    # Fastlane create_keychain bazen '-db' olmadan yol döner, dosya varlığını garantiye alalım:
    raw_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    actual_keychain_path = if File.exist?("#{raw_path}-db")
      "#{raw_path}-db"
    elsif File.exist?(raw_path)
      raw_path
    else
      `security default-keychain`.strip.tr('"', '').strip
    end

    UI.message("Aktif Anahtarlık Dosyası: #{actual_keychain_path}")

    # Anahtarlığı listeye ekle ve kilidini aç
    _, _, unlock_status = Open3.capture3("security", "unlock-keychain", "-p", keychain_password, actual_keychain_path)
    UI.user_error!("Geçici anahtarlık açılamadı.") unless unlock_status.success?
    sh("security default-keychain -s '#{actual_keychain_path}'") rescue nil

    # 4. Apple Sertifikalarını ve Dağıtım Profilini Otomatik Çek / Senkronize Et
    # App Store Connect API Key sayesinde Mac olmadan Apple hesabından direkt profil ve sertifika yönetilir
    if ENV["MATCH_GIT_URL"] && !ENV["MATCH_GIT_URL"].empty?
      # Opsiyon A: Fastlane match kullanılıyorsa
      match(
        type: "appstore",
        api_key: api_key,
        readonly: true,
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
    else
      # Opsiyon B: API Key ile doğrudan App Store sertifikasını ve profilini yönet
      certs_dir = File.expand_path("../certs", __dir__)
      FileUtils.mkdir_p(certs_dir)
      p12_path = File.join(certs_dir, "dist_certificate.p12")

      if File.exist?(p12_path)
        UI.success("Dağıtım sertifikası bulundu.")
        # Fastlane's sh action adds command arguments to its public summary, so
        # keep all password-bearing commands out of that action and its logs.
        _, _, import_status = Open3.capture3("security", "import", p12_path, "-k", actual_keychain_path, "-P", keychain_password, "-T", "/usr/bin/codesign", "-T", "/usr/bin/security")
        UI.user_error!("Dağıtım sertifikası macOS anahtarlığına aktarılamadı.") unless import_status.success?
        _, _, partition_status = Open3.capture3("security", "set-key-partition-list", "-S", "apple-tool:,apple:,codesign:", "-s", "-k", keychain_password, actual_keychain_path)
        UI.user_error!("İmzalama anahtarının erişimi ayarlanamadı.") unless partition_status.success?
      else
        UI.user_error!("Dağıtım sertifikası eksik; yeni sertifika otomatik oluşturulmaz.")
      end

      # 4.1. Yetenekler hesapta önceden ayarlanmış olmalı; build sırasında değiştirilmez.
      begin
        bundle_id = Spaceship::ConnectAPI::BundleId.find("com.twoplayersnake.app")
        UI.user_error!("Uygulamanın Apple App ID kaydı bulunamadı.") unless bundle_id
        caps = bundle_id.get_capabilities
        UI.user_error!("Associated Domains yetkisi eksik; Apple hesabında ayrıca incelenmeli.") unless caps && caps.any? { |c| c.capability_type == "ASSOCIATED_DOMAINS" }
        UI.success("Associated Domains yetkisi App ID üzerinde etkin.")
      rescue => ex
        UI.user_error!("Associated Domains kontrolü başarısız: #{ex.message}")
      end

      # readonly conflicts with an explicitly supplied force value in sigh.
      # Remove the environment override as well; sigh defaults force to false.
      ENV.delete("SIGH_FORCE")
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: "com.twoplayersnake.app",
        provisioning_name: "2 Player Snake App Store V2 2026",
        ignore_profiles_with_different_name: true,
        cert_id: "ZPZMAX7K2S",
        readonly: true
      )
    end

    # 5. Build ve Versiyon Numarasını Ayarla
    build_num = options[:build_number]
    if build_num.nil? || build_num.empty?
      if ENV["GITHUB_REF_NAME"] && ENV["GITHUB_REF_NAME"] =~ /-b(\d+)$/
        build_num = $1
      else
        build_num = ENV["GITHUB_RUN_NUMBER"] || "30"
      end
    end

    version_num = options[:version]
    if (version_num.nil? || version_num.empty?) && ENV["GITHUB_REF_NAME"] && ENV["GITHUB_REF_NAME"] =~ /^ios-v([0-9.]+)-b/
      version_num = $1
    end
    version_num ||= ENV["MARKETING_VERSION"] || "3.6.5"

    proj_path = File.expand_path("../TwoPlayerSnake.xcodeproj", __dir__)
    UI.message("Xcode Proje Yolu: #{proj_path}")

    if File.exist?(proj_path)
      begin
        increment_version_number(
          version_number: version_num,
          xcodeproj: proj_path
        )
      rescue => ex
        UI.important("increment_version_number uyarısı (#{ex.message})")
      end

      begin
        increment_build_number(
          build_number: build_num,
          xcodeproj: proj_path
        )
      rescue => ex
        UI.important("increment_build_number uyarısı (#{ex.message}), xcargs ile devam ediliyor.")
      end

      plist_path = File.expand_path("../TwoPlayerSnake/Info.plist", __dir__)
      if File.exist?(plist_path)
        set_info_plist_value(path: plist_path, key: "CFBundleShortVersionString", value: version_num) rescue nil
        set_info_plist_value(path: plist_path, key: "CFBundleVersion", value: build_num) rescue nil
        UI.success("Info.plist güncellendi: Version=#{version_num}, Build=#{build_num}")
      end

      # 6. Kod İmzalama Ayarlarını Güncelle
      profile_name = lane_context[SharedValues::SIGH_NAME] || ENV["sigh_com.twoplayersnake.app_app-store_profile-name"] || "com.twoplayersnake.app AppStore"
      UI.message("Kullanılacak Dağıtım Profili: #{profile_name}")

      begin
        update_code_signing_settings(
          use_automatic_signing: false,
          path: proj_path,
          team_id: ENV["APPLE_TEAM_ID"] || "GUFQF359Q7",
          bundle_identifier: "com.twoplayersnake.app",
          code_sign_identity: "Apple Distribution",
          profile_name: profile_name
        )
      rescue => ex
        UI.important("update_code_signing_settings uyarısı (#{ex.message})")
      end

      export_opts = {
        method: "app-store"
      }
      if cloudkit_testflight
        # This packaged-game build is for internal tests and must not be
        # promoted to the App Store; the final build uses the production URL.
        export_opts[:testFlightInternalTestingOnly] = true
      end
      if profile_name && !profile_name.empty?
        export_opts[:provisioningProfiles] = {
          "com.twoplayersnake.app" => profile_name
        }
      end

      # 6.5. CocoaPods Bağımlılıklarını Doğrula (Google Mobile Ads SDK)
      podfile_path = File.expand_path("../Podfile", __dir__)
      if File.exist?(podfile_path)
        UI.message("Podfile bulundu. CocoaPods bağımlılıkları kontrol ediliyor...")
        begin
          cocoapods(
            clean_install: false,
            podfile: podfile_path,
            try_repo_update_on_error: true
          )
        rescue => ex
          UI.important("Fastlane cocoapods uyarısı: #{ex.message}. Mevcut workspace ile devam ediliyor.")
        end
      end

      # 7. Uygulamayı Derle (.ipa Üretimi)
      build_output_dir = File.expand_path("../build", __dir__)
      workspace_path = File.expand_path("../TwoPlayerSnake.xcworkspace", __dir__)

      # The internal build uses bundled HTML; the release candidate uses the
      # separately verified live HTML while retaining the same CloudKit setup.
      build_xcargs = "CURRENT_PROJECT_VERSION=#{build_num} MARKETING_VERSION=#{version_num}"
      build_xcargs += " CODE_SIGN_ENTITLEMENTS=TwoPlayerSnake/CloudKit.staged.entitlements SNAKE_CLOUDKIT_CONTAINER_ID=iCloud.com.twoplayersnake.app"
      build_xcargs += " SNAKE_TESTFLIGHT_BUNDLED_GAME=#{cloudkit_testflight ? 'YES' : 'NO'}"
      UI.message(cloudkit_testflight ? "iCloud açık iç test yapılandırması seçildi." : "iCloud açık yayın adayı yapılandırması seçildi.")

      build_params = {
        scheme: "TwoPlayerSnake",
        output_directory: build_output_dir,
        output_name: "2PlayerSnake.ipa",
        clean: true,
        export_method: "app-store",
        export_options: export_opts,
        codesigning_identity: "Apple Distribution",
        xcargs: build_xcargs
      }

      if File.exist?(workspace_path)
        UI.message("CocoaPods Workspace bulundu: #{workspace_path}")
        build_params[:workspace] = workspace_path
      else
        UI.message("Xcode Projesi üzerinden derleniyor: #{proj_path}")
        build_params[:project] = proj_path
      end

      build_app(build_params)

      # 8. TestFlight'a Yükle
      ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH] || File.join(build_output_dir, "2PlayerSnake.ipa")
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_path,
        skip_waiting_for_build_processing: true, # CI runner'in bos yere beklemesini onler
        changelog: "2 Player Snake iOS Beta Derlemesi (#{build_num})"
      )
      UI.success("2 Player Snake basariyla TestFlight'a yuklendi!")

      # Store listing changes are a separate, explicitly authorized operation.
    else
      UI.user_error!("TwoPlayerSnake.xcodeproj bulunamadı! Lütfen proje yolunu kontrol edin: #{proj_path}")
    end
  end
end
